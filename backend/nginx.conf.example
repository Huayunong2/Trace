# Nginx配置文件示例
# 将此文件复制到 /etc/nginx/sites-available/elderly_tracking
# 然后创建软链接: sudo ln -s /etc/nginx/sites-available/elderly_tracking /etc/nginx/sites-enabled/
# 修改后测试: sudo nginx -t
# 重载配置: sudo systemctl reload nginx

upstream django {
    server 127.0.0.1:8000;  # Gunicorn监听的地址
    # 如果需要多进程，可以添加更多server
    # server 127.0.0.1:8001;
}

server {
    listen 80;
    server_name your-domain.com;  # 修改为您的域名
    
    # 重定向所有HTTP请求到HTTPS
    return 301 https://$server_name$request_uri;
}

server {
    listen 443 ssl http2;
    server_name your-domain.com;  # 修改为您的域名
    
    # SSL证书配置
    ssl_certificate /path/to/your/cert.pem;  # 修改为您的证书路径
    ssl_certificate_key /path/to/your/key.pem;  # 修改为您的私钥路径
    
    # SSL优化配置
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;
    
    # 客户端最大上传大小
    client_max_body_size 10M;
    
    # 日志
    access_log /var/log/nginx/elderly_tracking_access.log;
    error_log /var/log/nginx/elderly_tracking_error.log;
    
    # 静态文件
    location /static/ {
        alias /root/Project/backend/staticfiles/;
        expires 30d;
        add_header Cache-Control "public, immutable";
    }
    
    # 媒体文件
    location /media/ {
        alias /root/Project/backend/media/;
        expires 7d;
        add_header Cache-Control "public";
    }
    
    # API请求转发到Django
    location /api/ {
        proxy_pass http://django;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_redirect off;
        
        # 超时设置
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }
    
    # Admin后台
    location /admin/ {
        proxy_pass http://django;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_redirect off;
    }
    
    # 健康检查
    location /health/ {
        proxy_pass http://django;
        access_log off;
    }
}

