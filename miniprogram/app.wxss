/**app.wxss**/
page {
  background: linear-gradient(180deg, #f8f9fa 0%, #f5f5f5 100%);
  font-size: 32rpx;
  color: #333;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', 'Helvetica Neue', Arial, sans-serif;
  min-height: 100vh;
}

.container {
  padding: 24rpx;
  min-height: calc(100vh - 200rpx);
}

/* 大字体样式（适合老年人） */
.large-text {
  font-size: 36rpx;
  font-weight: 500;
  line-height: 1.5;
}

.extra-large-text {
  font-size: 42rpx;
  font-weight: 600;
  line-height: 1.4;
}

/* 按钮样式 - 现代化设计 */
.btn {
  padding: 28rpx 48rpx;
  border-radius: 12rpx;
  font-size: 32rpx;
  text-align: center;
  border: none;
  font-weight: 500;
  transition: all 0.3s ease;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}

.btn-primary {
  background: linear-gradient(135deg, #4A90E2 0%, #357ABD 100%);
  color: #fff;
}

.btn-primary:active {
  transform: translateY(2rpx);
  box-shadow: 0 2rpx 8rpx rgba(74, 144, 226, 0.3);
}

.btn-danger {
  background: linear-gradient(135deg, #E74C3C 0%, #C0392B 100%);
  color: #fff;
}

.btn-danger:active {
  transform: translateY(2rpx);
  box-shadow: 0 2rpx 8rpx rgba(231, 76, 60, 0.3);
}

.btn-success {
  background: linear-gradient(135deg, #27AE60 0%, #229954 100%);
  color: #fff;
}

.btn-success:active {
  transform: translateY(2rpx);
  box-shadow: 0 2rpx 8rpx rgba(39, 174, 96, 0.3);
}

/* 卡片样式 - 现代化设计 */
.card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
  transition: all 0.3s ease;
}

.card:active {
  transform: translateY(-2rpx);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.1);
}

/* 列表项样式 - 更优雅 */
.list-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 24rpx;
  background-color: #fff;
  border-bottom: 1rpx solid #f0f0f0;
  transition: background-color 0.2s ease;
}

.list-item:active {
  background-color: #f8f9fa;
}

.list-item:last-child {
  border-bottom: none;
}

/* 现代化输入框样式 */
input, textarea {
  background-color: #f8f9fa;
  border: 2rpx solid #e9ecef;
  border-radius: 12rpx;
  padding: 24rpx;
  font-size: 32rpx;
  transition: all 0.3s ease;
}

input:focus, textarea:focus {
  border-color: #4A90E2;
  background-color: #fff;
  box-shadow: 0 0 0 4rpx rgba(74, 144, 226, 0.1);
}

/* 标签样式 */
.tag {
  display: inline-block;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  font-weight: 500;
  background-color: #f0f0f0;
  color: #666;
}

.tag-primary {
  background-color: rgba(74, 144, 226, 0.1);
  color: #4A90E2;
}

.tag-success {
  background-color: rgba(39, 174, 96, 0.1);
  color: #27AE60;
}

.tag-danger {
  background-color: rgba(231, 76, 60, 0.1);
  color: #E74C3C;
}

.tag-warning {
  background-color: rgba(255, 152, 0, 0.1);
  color: #FF9800;
}

/* 分隔线 */
.divider {
  height: 1rpx;
  background: linear-gradient(90deg, transparent, #e9ecef, transparent);
  margin: 24rpx 0;
}

/* 加载状态 */
.loading {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 60rpx 0;
  color: #999;
  font-size: 28rpx;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 80rpx 40rpx;
  color: #999;
}

.empty-state-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
  opacity: 0.5;
}

/* 渐变背景 */
.gradient-bg {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.gradient-bg-blue {
  background: linear-gradient(135deg, #4A90E2 0%, #357ABD 100%);
}

/* 阴影效果 */
.shadow-sm {
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
}

.shadow-md {
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.12);
}

.shadow-lg {
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.16);
}
