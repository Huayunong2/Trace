/* pages/admin/index/index.wxss */

.container {
  padding: 24rpx;
  background: #f5f5f5;
  min-height: 100vh;
}

.header-section {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 80rpx 32rpx 40rpx;
  margin: -24rpx -24rpx 24rpx -24rpx;
  color: #fff;
  padding-top: calc(80rpx + env(safe-area-inset-top));
}

.header-content {
  text-align: center;
}

.logout-section {
  margin: 40rpx 0;
  padding-bottom: 40rpx;
}

.logout-btn {
  width: 100%;
  height: 96rpx;
  background: #fff;
  color: #666;
  border: 2rpx solid #e0e0e0;
  border-radius: 12rpx;
  font-size: 32rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.logout-btn:active {
  background: #f5f5f5;
  transform: scale(0.98);
}

.header-action {
  position: absolute;
  top: 40rpx;
  right: 32rpx;
}

.logout-btn-small {
  padding: 12rpx 24rpx;
  background: rgba(255, 255, 255, 0.2);
  color: #fff;
  border: 1px solid rgba(255, 255, 255, 0.3);
  border-radius: 8rpx;
  font-size: 24rpx;
  line-height: 1.5;
}

.greeting-text {
  font-size: 48rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.subtitle-text {
  font-size: 28rpx;
  opacity: 0.9;
}

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.card-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
}

.refresh-btn {
  font-size: 26rpx;
  color: #4A90E2;
  padding: 8rpx 16rpx;
}

.loading {
  text-align: center;
  padding: 60rpx;
  color: #999;
  font-size: 28rpx;
}

.statistics-card {
  background: linear-gradient(135deg, #f8f9fa 0%, #ffffff 100%);
}

.statistics-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24rpx;
}

.stat-item {
  text-align: center;
  padding: 24rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.stat-item.highlight {
  background: linear-gradient(135deg, #FF6B6B 0%, #EE5A6F 100%);
  color: #fff;
}

.stat-value {
  font-size: 48rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 8rpx;
}

.stat-item.highlight .stat-value {
  color: #fff;
}

.stat-label {
  font-size: 24rpx;
  color: #666;
}

.stat-item.highlight .stat-label {
  color: rgba(255, 255, 255, 0.9);
}

.menu-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: linear-gradient(135deg, #f8f9fa 0%, #ffffff 100%);
  border-radius: 16rpx;
  transition: all 0.3s ease;
}

.menu-item:active {
  transform: scale(0.98);
  background: linear-gradient(135deg, #e9ecef 0%, #f8f9fa 100%);
}

.menu-icon {
  font-size: 56rpx;
  margin-right: 24rpx;
  width: 80rpx;
  text-align: center;
}

.menu-content {
  flex: 1;
}

.menu-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
}

.menu-desc {
  font-size: 24rpx;
  color: #999;
}

.menu-arrow {
  font-size: 40rpx;
  color: #ccc;
  margin-left: 16rpx;
}

