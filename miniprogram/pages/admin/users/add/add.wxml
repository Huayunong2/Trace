<!--pages/admin/users/add/add.wxml-->
<view class="container">
  <view class="card">
    <view class="card-title">添加用户</view>
    
    <view class="form-group">
      <view class="form-label">用户名 <text class="required">*</text></view>
      <input class="form-input" placeholder="请输入用户名" value="{{formData.username}}" bindinput="onUsernameInput" maxlength="50"/>
    </view>

    <view class="form-group">
      <view class="form-label">手机号</view>
      <input class="form-input" placeholder="请输入手机号（可选）" type="number" value="{{formData.phone}}" bindinput="onPhoneInput" maxlength="11"/>
    </view>

    <view class="form-group">
      <view class="form-label">角色 <text class="required">*</text></view>
      <picker mode="selector" range="{{roleLabels}}" value="{{roleOptions.indexOf(formData.role)}}" bindchange="onRoleChange">
        <view class="picker-view">
          <text>{{roleLabels[roleOptions.indexOf(formData.role)]}}</text>
          <text class="arrow">›</text>
        </view>
      </picker>
    </view>

    <view class="form-buttons">
      <button class="btn btn-secondary" bindtap="goBack">取消</button>
      <button class="btn btn-primary" bindtap="submit">创建</button>
    </view>
  </view>
</view>

