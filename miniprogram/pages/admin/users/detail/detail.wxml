<!--pages/admin/users/detail/detail.wxml-->
<view class="container">
  <view wx:if="{{loading}}" class="loading">加载中...</view>
  
  <view wx:elif="{{user}}" class="card">
    <view class="user-header">
      <image wx:if="{{user.avatar}}" src="{{user.avatar}}" class="user-avatar-large" mode="aspectFill"></image>
      <image wx:else src="/images/avatar-default.png" class="user-avatar-large" mode="aspectFill"></image>
      <view class="user-name-large">{{user.username}}</view>
      <view class="role-badge-large role-{{user.role}}">
        {{user.role === 'guardian' ? '监护人' : user.role === 'elderly' ? '老人' : user.role === 'system_admin' ? '系统管理员' : '未知'}}
      </view>
    </view>

    <view class="info-section">
      <view class="info-item">
        <text class="info-label">用户ID</text>
        <text class="info-value">{{user.id}}</text>
      </view>
      <view class="info-item">
        <text class="info-label">手机号</text>
        <text class="info-value">{{user.phone || '未设置'}}</text>
      </view>
      <view class="info-item">
        <text class="info-label">微信OpenID</text>
        <text class="info-value" style="font-size: 22rpx;">{{user.openid || '未设置'}}</text>
      </view>
      <view class="info-item">
        <text class="info-label">账户状态</text>
        <text class="info-value" style="color: {{user.is_active ? '#4CAF50' : '#FF5252'}};">
          {{user.is_active ? '启用' : '禁用'}}
        </text>
      </view>
      <view class="info-item">
        <text class="info-label">创建时间</text>
        <text class="info-value">{{user.created_at}}</text>
      </view>
      <view class="info-item">
        <text class="info-label">更新时间</text>
        <text class="info-value">{{user.updated_at}}</text>
      </view>
    </view>

    <view class="actions-section">
      <button class="btn btn-primary" bindtap="changeRole">修改角色</button>
      <button class="btn btn-danger" bindtap="deleteUser">
        <image src="/images/delete.png" class="btn-icon" mode="aspectFit"></image>
        <text>删除用户</text>
      </button>
    </view>
  </view>
</view>

