/* pages/admin/config/config.wxss */

.container {
  padding: 24rpx;
  background: #f5f5f5;
  min-height: 100vh;
}

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.card-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
}

.refresh-btn {
  font-size: 26rpx;
  color: #4A90E2;
  padding: 8rpx 16rpx;
}

.btn-add {
  padding: 12rpx 24rpx;
  background: linear-gradient(135deg, #4CAF50 0%, #45a049 100%);
  color: #fff;
  border-radius: 12rpx;
  font-size: 26rpx;
  border: none;
  line-height: 1.5;
}

.loading, .empty-state {
  text-align: center;
  padding: 60rpx;
  color: #999;
  font-size: 28rpx;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
  opacity: 0.5;
}

.config-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.config-item {
  padding: 24rpx;
  background: linear-gradient(135deg, #f8f9fa 0%, #ffffff 100%);
  border-radius: 16rpx;
  border-left: 4rpx solid #4A90E2;
}

.config-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.config-key {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.config-actions {
  display: flex;
  gap: 16rpx;
}

.action-btn {
  padding: 8rpx 16rpx;
  background: #E3F2FD;
  color: #1976D2;
  border-radius: 8rpx;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
}

.action-btn-icon {
  width: 24rpx;
  height: 24rpx;
  flex-shrink: 0;
}

.action-btn.danger {
  background: #FFEBEE;
  color: #C62828;
}

.config-value {
  display: flex;
  align-items: flex-start;
  margin-bottom: 12rpx;
  padding: 16rpx;
  background: #f8f9fa;
  border-radius: 8rpx;
}

.value-label {
  font-size: 26rpx;
  color: #666;
  margin-right: 12rpx;
  min-width: 60rpx;
}

.value-text {
  flex: 1;
  font-size: 26rpx;
  color: #333;
  word-break: break-all;
}

.config-meta {
  display: flex;
  gap: 24rpx;
  margin-bottom: 12rpx;
  font-size: 24rpx;
  color: #999;
}

.config-desc {
  font-size: 24rpx;
  color: #666;
  padding-top: 12rpx;
  border-top: 1rpx solid #f0f0f0;
}

.add-form {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 1000;
  max-height: 85vh;
  overflow-y: auto;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx;
  box-shadow: 0 -4rpx 24rpx rgba(0, 0, 0, 0.1);
}

.form-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 32rpx;
  text-align: center;
}

.form-group {
  margin-bottom: 28rpx;
}

.form-label {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 12rpx;
  display: block;
}

.form-input, .form-textarea {
  background-color: #f8f9fa;
  padding: 24rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  width: 100%;
  box-sizing: border-box;
}

.form-textarea {
  min-height: 150rpx;
}

.form-picker {
  background-color: #f8f9fa;
  padding: 24rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.picker-arrow {
  color: #999;
  font-size: 24rpx;
}

.form-buttons {
  display: flex;
  gap: 20rpx;
  margin-top: 40rpx;
}

.btn {
  flex: 1;
  padding: 24rpx;
  border-radius: 12rpx;
  font-size: 32rpx;
  font-weight: 500;
  border: none;
}

.btn-secondary {
  background-color: #f0f0f0;
  color: #666;
}

.btn-primary {
  background: linear-gradient(135deg, #4A90E2 0%, #357ABD 100%);
  color: #fff;
}

