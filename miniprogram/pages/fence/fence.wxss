/* pages/fence/fence.wxss */

.container {
  padding: 24rpx;
  background: #f5f5f5;
  min-height: 100vh;
}

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

/* 头部区域 */
.large-text {
  font-size: 36rpx;
  color: #333;
}

/* 围栏列表项 */
.fence-item {
  background: linear-gradient(135deg, #f8f9fa 0%, #ffffff 100%);
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  border-left: 6rpx solid #4CAF50;
  transition: all 0.3s ease;
}

.fence-item.violation {
  border-left-color: #FF5252;
  background: linear-gradient(135deg, #FFEBEE 0%, #ffffff 100%);
}

.fence-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.fence-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.fence-status {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.status-badge {
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  font-weight: 500;
}

.status-active {
  background: #E8F5E9;
  color: #4CAF50;
}

.status-violation {
  background: #FFEBEE;
  color: #FF5252;
}

.fence-info {
  color: #666;
  font-size: 28rpx;
  line-height: 1.8;
  margin-bottom: 12rpx;
}

.fence-address {
  display: flex;
  align-items: flex-start;
  gap: 8rpx;
  margin-bottom: 12rpx;
}

.fence-details {
  display: flex;
  gap: 24rpx;
  font-size: 26rpx;
  color: #999;
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid #f0f0f0;
}

.fence-stat {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

/* 开关样式 */
switch {
  transform: scale(0.9);
}

/* 添加按钮 */
.btn {
  border-radius: 12rpx;
  padding: 20rpx 32rpx;
  font-size: 28rpx;
  font-weight: 500;
  border: none;
  transition: all 0.3s ease;
}

.btn-primary {
  background: linear-gradient(135deg, #4CAF50 0%, #45a049 100%);
  color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(76, 175, 80, 0.3);
}

.btn-primary:active {
  transform: translateY(2rpx);
  box-shadow: 0 2rpx 8rpx rgba(76, 175, 80, 0.4);
}

/* 添加表单 */
.add-form {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 1000;
  max-height: 85vh;
  overflow-y: auto;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx;
  box-shadow: 0 -4rpx 24rpx rgba(0, 0, 0, 0.1);
}

.form-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 32rpx;
  text-align: center;
}

.form-group {
  margin-bottom: 28rpx;
}

.form-label {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 12rpx;
  display: block;
}

.form-input {
  background-color: #f8f9fa;
  padding: 24rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  width: 100%;
  box-sizing: border-box;
  color: #333;
  line-height: 1.5;
  min-height: 76rpx;
}

.form-hint {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

.form-buttons {
  display: flex;
  gap: 20rpx;
  margin-top: 40rpx;
}

.btn-secondary {
  flex: 1;
  background-color: #f0f0f0;
  color: #666;
}

.btn-submit {
  flex: 1;
  background: linear-gradient(135deg, #4CAF50 0%, #45a049 100%);
  color: #fff;
}

.location-button {
  width: 100%;
  background: linear-gradient(135deg, #2196F3 0%, #1976D2 100%);
  color: #fff;
  padding: 24rpx;
  border-radius: 12rpx;
  margin-bottom: 12rpx;
  box-shadow: 0 4rpx 12rpx rgba(33, 150, 243, 0.3);
}

.location-helpers {
  display: flex;
  gap: 12rpx;
}

.btn-helper {
  flex: 1;
  background-color: #f0f0f0;
  color: #666;
  font-size: 26rpx;
  padding: 16rpx;
}

.coordinate-info {
  margin-top: 12rpx;
  color: #666;
  font-size: 24rpx;
  padding: 16rpx;
  background: #f8f9fa;
  border-radius: 8rpx;
}

.coordinate-warning {
  margin-top: 12rpx;
  color: #FF9800;
  font-size: 24rpx;
  padding: 16rpx;
  background: #FFF3E0;
  border-radius: 8rpx;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 80rpx 40rpx;
  color: #999;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 28rpx;
}

/* 围栏操作按钮 */
.fence-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
}

.btn-edit, .btn-delete {
  flex: 1;
  padding: 16rpx;
  border-radius: 8rpx;
  font-size: 26rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.btn-icon {
  width: 28rpx;
  height: 28rpx;
  flex-shrink: 0;
}

.btn-edit {
  background: linear-gradient(135deg, #2196F3 0%, #1976D2 100%);
  color: #fff;
}

.btn-delete {
  background: linear-gradient(135deg, #FF5252 0%, #E53935 100%);
  color: #fff;
}
