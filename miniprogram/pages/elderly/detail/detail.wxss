/* pages/elderly/detail.wxss */

/* 状态指示点 */
.status-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  display: inline-block;
}

.status-dot.online {
  background-color: #27AE60;
  box-shadow: 0 0 8rpx rgba(39, 174, 96, 0.5);
}

.status-dot.offline {
  background-color: #BDC3C7;
}

.status-dot.low-battery {
  background-color: #FF9800;
  box-shadow: 0 0 8rpx rgba(255, 152, 0, 0.5);
}

/* 电量显示 */
.battery-wrapper {
  width: 120rpx;
  height: 32rpx;
  border: 2rpx solid #ddd;
  border-radius: 6rpx;
  background-color: #f5f5f5;
  overflow: hidden;
  position: relative;
  display: inline-block;
}

.battery-wrapper::after {
  content: '';
  position: absolute;
  right: -6rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 4rpx;
  height: 16rpx;
  background-color: #ddd;
  border-radius: 0 2rpx 2rpx 0;
}

.battery-level {
  height: 100%;
  transition: width 0.3s ease, background-color 0.3s ease;
  border-radius: 4rpx;
}

.list-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.status-wrapper {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.status-icon {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
  display: block;
}

.status-text {
  font-size: 28rpx;
  line-height: 1.2;
  display: flex;
  align-items: center;
}

/* 操作栏 */
.action-bar {
  display: flex;
  gap: 20rpx;
  padding: 20rpx;
  background: white;
  margin-bottom: 20rpx;
  border-radius: 16rpx;
}

.btn-edit,
.btn-delete {
  flex: 1;
  padding: 20rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
  text-align: center;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.btn-icon {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
}

.btn-edit {
  background: #4A90E2;
  color: white;
}

.btn-delete {
  background: #FF5252;
  color: white;
}

/* 表单样式 */
.form-title {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 40rpx;
  color: #333;
}

.form-group {
  margin-bottom: 40rpx;
}

.form-label {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 16rpx;
}

.required {
  color: #FF5252;
}

.form-input {
  width: 100%;
  padding: 24rpx;
  border: 1px solid #e0e0e0;
  border-radius: 8rpx;
  font-size: 28rpx;
  background-color: #fff;
  box-sizing: border-box;
  color: #333;
  line-height: 1.5;
  min-height: 76rpx;
}

.form-textarea {
  width: 100%;
  min-height: 150rpx;
  padding: 24rpx;
  border: 1px solid #e0e0e0;
  border-radius: 8rpx;
  font-size: 28rpx;
  background-color: #fff;
  box-sizing: border-box;
}

.radio-label {
  display: inline-block;
  margin-right: 40rpx;
  font-size: 28rpx;
}

.form-buttons {
  display: flex;
  gap: 20rpx;
  margin-top: 60rpx;
}

.btn-secondary {
  flex: 1;
  padding: 24rpx;
  background: #f5f5f5;
  color: #666;
  border-radius: 8rpx;
  font-size: 28rpx;
  text-align: center;
}

.btn-primary {
  flex: 1;
  padding: 24rpx;
  background: #4A90E2;
  color: white;
  border-radius: 8rpx;
  font-size: 28rpx;
  text-align: center;
}
