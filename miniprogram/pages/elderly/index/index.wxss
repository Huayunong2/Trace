/* pages/elderly/index/index.wxss - 老人角色首页样式 */
.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 40rpx;
}

.header-section {
  background: linear-gradient(135deg, #ff9a56 0%, #ff6a88 100%);
  padding: 80rpx 40rpx 80rpx;
  color: #fff;
  padding-top: calc(80rpx + env(safe-area-inset-top));
}

.header-content {
  text-align: center;
}

.action-section {
  margin: 40rpx 30rpx;
  padding-bottom: 40rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.refresh-btn {
  width: 100%;
  height: 96rpx;
  background: #4A90E2;
  color: #fff;
  border-radius: 12rpx;
  font-size: 32rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 8rpx rgba(74, 144, 226, 0.2);
  border: none;
}

.refresh-btn:active {
  background: #357ABD;
  transform: scale(0.98);
}

.logout-btn {
  width: 100%;
  height: 96rpx;
  background: #fff;
  color: #666;
  border: 2rpx solid #e0e0e0;
  border-radius: 12rpx;
  font-size: 32rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.logout-btn:active {
  background: #f5f5f5;
  transform: scale(0.98);
}

.greeting-text {
  font-size: 48rpx;
  font-weight: bold;
  margin-bottom: 16rpx;
}

.subtitle-text {
  font-size: 28rpx;
  opacity: 0.9;
}

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 40rpx;
  margin: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}

.card-title {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 30rpx;
  color: #333;
}

.device-info {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.device-status {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.status-icon {
  width: 40rpx;
  height: 40rpx;
  flex-shrink: 0;
  display: block;
}

.status-text {
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
  line-height: 1.2;
  display: flex;
  align-items: center;
}

.device-battery {
  font-size: 28rpx;
  color: #666;
}

.device-name {
  font-size: 28rpx;
  color: #999;
}

.device-id {
  font-size: 26rpx;
  color: #666;
  word-break: break-all;
}

.device-tip {
  margin-top: 16rpx;
  padding: 16rpx;
  background-color: #FFF3E0;
  border-radius: 8rpx;
  font-size: 24rpx;
  color: #F57C00;
  text-align: center;
}

.no-device {
  text-align: center;
  color: #999;
  padding: 40rpx 0;
}

.action-buttons {
  display: flex;
  gap: 20rpx;
}

.action-btn {
  flex: 1;
  height: 160rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #fff;
  border: none;
  box-shadow: 0 4rpx 12rpx rgba(102, 126, 234, 0.3);
}

.sos-btn {
  background: linear-gradient(135deg, #E74C3C 0%, #C0392B 100%);
  box-shadow: 0 4rpx 12rpx rgba(231, 76, 60, 0.3);
}

.location-btn {
  background: linear-gradient(135deg, #27AE60 0%, #229954 100%);
  box-shadow: 0 4rpx 12rpx rgba(39, 174, 96, 0.3);
}

.btn-icon {
  font-size: 60rpx;
  margin-bottom: 12rpx;
}

.btn-text {
  font-size: 28rpx;
  font-weight: 500;
}

.location-info {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  font-size: 28rpx;
  color: #666;
}

.location-time {
  margin-top: 20rpx;
  font-size: 24rpx;
  color: #999;
  text-align: right;
}

/* 未绑定状态样式 */
.device-status.unbound {
  padding: 20rpx;
  background: #FFF3E0;
  border-radius: 12rpx;
  justify-content: center;
}

.device-status.unbound .status-text {
  color: #F57C00;
  font-weight: 600;
}

.binding-status-section {
  margin-top: 30rpx;
  padding-top: 30rpx;
  border-top: 2rpx dashed #e0e0e0;
}

.bound-status {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 24rpx;
  background: #E8F5E9;
  border-radius: 12rpx;
  border: 2rpx solid #4CAF50;
}

.bound-status .status-icon {
  font-size: 32rpx;
}

.bound-status .status-text {
  font-size: 28rpx;
  color: #2E7D32;
  font-weight: 500;
}

.unbound-section {
  margin-top: 0;
  padding-top: 0;
  border-top: none;
}

.unbound-tip {
  padding: 20rpx;
  background: #E3F2FD;
  border-radius: 12rpx;
  margin-bottom: 30rpx;
  text-align: center;
}

.unbound-tip text {
  font-size: 26rpx;
  color: #1976D2;
  line-height: 1.6;
}

.device-id-display {
  padding: 24rpx;
  background: #f8f9fa;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.device-id-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.device-id-label {
  font-size: 28rpx;
  color: #666;
  font-weight: 500;
}

.device-id-value {
  flex: 1;
  font-size: 26rpx;
  color: #333;
  font-family: 'Courier New', monospace;
  word-break: break-all;
  background: #fff;
  padding: 12rpx 16rpx;
  border-radius: 8rpx;
  border: 1rpx solid #e0e0e0;
  white-space: normal;
  line-height: 1.6;
  word-wrap: break-word;
  overflow-wrap: break-word;
  display: block;
}

.copy-btn {
  flex-shrink: 0;
  padding: 12rpx 24rpx;
  background: #4A90E2;
  color: #fff;
  border-radius: 8rpx;
  font-size: 26rpx;
  border: none;
  line-height: 1.5;
  height: auto;
  min-width: 120rpx;
}

.copy-btn:active {
  background: #357ABD;
  transform: scale(0.95);
}

