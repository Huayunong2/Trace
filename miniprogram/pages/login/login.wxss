/* pages/login/login.wxss */
.login-container {
  min-height: 100vh;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 50%, #f093fb 100%);
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  overflow: hidden;
}

.bg-decoration {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
  z-index: 0;
  animation: float 6s ease-in-out infinite;
}

.bg-decoration-1 {
  width: 500rpx;
  height: 500rpx;
  top: -150rpx;
  right: -150rpx;
  animation-delay: 0s;
}

.bg-decoration-2 {
  width: 400rpx;
  height: 400rpx;
  bottom: -100rpx;
  left: -100rpx;
  animation-delay: 2s;
}

@keyframes float {
  0%, 100% {
    transform: translateY(0) scale(1);
  }
  50% {
    transform: translateY(-20rpx) scale(1.05);
  }
}

.login-content {
  width: 100%;
  max-width: 600rpx;
  position: relative;
  z-index: 1;
}

.logo-section {
  text-align: center;
  margin-bottom: 120rpx;
  animation: fadeInDown 0.8s ease;
}

.logo-wrapper {
  position: relative;
  display: inline-block;
  margin-bottom: 40rpx;
}

.logo-icon {
  font-size: 160rpx;
  position: relative;
  z-index: 2;
  animation: bounce 2s infinite;
  filter: drop-shadow(0 8rpx 16rpx rgba(0, 0, 0, 0.2));
}

.logo-circle {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 200rpx;
  height: 200rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
  z-index: 1;
  animation: pulse 2s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% {
    transform: translate(-50%, -50%) scale(1);
    opacity: 0.5;
  }
  50% {
    transform: translate(-50%, -50%) scale(1.2);
    opacity: 0.3;
  }
}

.logo-text {
  font-size: 56rpx;
  font-weight: bold;
  color: #ffffff;
  margin-bottom: 20rpx;
  text-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.2);
}

.logo-desc {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
}

.login-section {
  animation: fadeInUp 0.8s ease;
}

.login-btn {
  width: 100%;
  height: 100rpx;
  background: linear-gradient(135deg, #07c160 0%, #06ad56 100%);
  border-radius: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: 600;
  color: #ffffff;
  box-shadow: 0 12rpx 40rpx rgba(7, 193, 96, 0.4), 
              0 4rpx 12rpx rgba(0, 0, 0, 0.15),
              inset 0 2rpx 4rpx rgba(255, 255, 255, 0.2);
  margin-bottom: 40rpx;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  position: relative;
  overflow: hidden;
  border: none;
}

.login-btn::before {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 0;
  height: 0;
  border-radius: 50%;
  background: rgba(102, 126, 234, 0.1);
  transform: translate(-50%, -50%);
  transition: width 0.6s, height 0.6s;
}

.login-btn::after {
  border: none;
}

.login-btn-hover::before,
.login-btn:active::before {
  width: 600rpx;
  height: 600rpx;
}

.login-btn:active {
  transform: scale(0.97);
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.12);
}

.login-btn-text {
  position: relative;
  z-index: 1;
  white-space: nowrap;
  font-size: 36rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

@keyframes fadeInDown {
  from {
    opacity: 0;
    transform: translateY(-40rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(40rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes bounce {
  0%, 100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-20rpx);
  }
}

/* 身份选择弹窗样式 */
.role-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
}

.role-modal-content {
  width: 90%;
  max-width: 680rpx;
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
  animation: modalSlideUp 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.3);
}

@keyframes modalSlideUp {
  from {
    transform: translateY(100%);
    opacity: 0;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}

.role-modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 40rpx 40rpx 24rpx;
  border-bottom: 1px solid #e8eef5;
  background: linear-gradient(135deg, #4A90E2 0%, #357ABD 100%);
  border-radius: 24rpx 24rpx 0 0;
}

.role-modal-title {
  font-size: 38rpx;
  font-weight: 600;
  color: #fff;
  letter-spacing: 1rpx;
}

.role-modal-close {
  font-size: 56rpx;
  color: rgba(255, 255, 255, 0.9);
  line-height: 1;
  padding: 0 12rpx;
  transition: all 0.3s ease;
}

.role-modal-close:active {
  transform: scale(0.9);
  color: #fff;
}

/* 用户信息填写区域（头像昵称） */
.user-info-section {
  padding: 40rpx;
  background: linear-gradient(135deg, #f8f9ff 0%, #f0f4ff 100%);
  border-bottom: 1px solid #e8eef5;
}

.user-info-item {
  display: flex;
  align-items: center;
  margin-bottom: 32rpx;
  padding: 24rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.user-info-item:last-child {
  margin-bottom: 0;
}

.user-info-label {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
  width: 120rpx;
  flex-shrink: 0;
}

.avatar-btn {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  padding: 0;
  margin: 0;
  background: linear-gradient(135deg, #E8F4FD 0%, #F0F7FF 100%);
  border: 3rpx solid #4A90E2;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  box-shadow: 0 4rpx 12rpx rgba(74, 144, 226, 0.15);
  transition: all 0.3s ease;
  position: relative;
}

.avatar-btn:active {
  transform: scale(0.95);
  box-shadow: 0 2rpx 8rpx rgba(74, 144, 226, 0.2);
}

.avatar-btn::after {
  border: none;
}

.avatar-preview {
  width: 134rpx;
  height: 134rpx;
  border-radius: 50%;
  object-fit: cover;
  display: block;
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
}

.avatar-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  font-size: 26rpx;
  color: #4A90E2;
  font-weight: 500;
}

.avatar-placeholder-icon {
  font-size: 48rpx;
  margin-bottom: 8rpx;
}

.avatar-placeholder-text {
  font-size: 22rpx;
}

.nickname-input {
  flex: 1;
  height: 80rpx;
  padding: 0 24rpx;
  border: 2rpx solid #e0e6ed;
  border-radius: 12rpx;
  font-size: 30rpx;
  background: #fff;
  color: #333;
  transition: all 0.3s ease;
}

.nickname-input:focus {
  border-color: #4A90E2;
  box-shadow: 0 0 0 4rpx rgba(74, 144, 226, 0.1);
}

.role-options {
  padding: 40rpx;
  background: #fafbfc;
}

.role-option {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 32rpx;
  margin-bottom: 24rpx;
  border: 2rpx solid #e8eef5;
  border-radius: 24rpx;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  background: #fff;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
  position: relative;
  overflow: hidden;
}

.role-option::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 8rpx;
  height: 100%;
  background: #4A90E2;
  opacity: 0;
  transition: opacity 0.3s ease;
}

.role-option:active {
  transform: scale(0.98);
}

.role-option.selected {
  border-color: #4A90E2;
  background: linear-gradient(135deg, #F0F7FF 0%, #E8F4FD 100%);
  box-shadow: 0 8rpx 24rpx rgba(74, 144, 226, 0.25);
  transform: translateX(4rpx);
}

.role-option.selected::before {
  opacity: 1;
}

.role-icon-wrapper {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 32rpx;
  background: linear-gradient(135deg, #f8f9ff 0%, #f0f4ff 100%);
  flex-shrink: 0;
  transition: all 0.3s ease;
}

.role-option.selected .role-icon-wrapper {
  background: linear-gradient(135deg, #4A90E2 0%, #357ABD 100%);
  box-shadow: 0 4rpx 12rpx rgba(74, 144, 226, 0.3);
  transform: scale(1.05);
}

.role-icon {
  font-size: 64rpx;
  transition: transform 0.3s ease;
}

.role-option.selected .role-icon {
  transform: scale(1.1);
}

.role-content {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.role-name {
  font-size: 34rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 8rpx;
  transition: color 0.3s ease;
}

.role-option.selected .role-name {
  color: #4A90E2;
}

.role-desc {
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
}

.role-option.selected .role-desc {
  color: #5a9dd4;
}

.role-check {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #4A90E2;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  transform: scale(0);
  transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  margin-left: 16rpx;
  flex-shrink: 0;
}

.role-option.selected .role-check {
  opacity: 1;
  transform: scale(1);
}

.role-check-icon {
  color: #fff;
  font-size: 28rpx;
  font-weight: bold;
}

.role-modal-footer {
  display: flex;
  border-top: 1px solid #f0f0f0;
  padding: 20rpx;
  gap: 20rpx;
}

.btn-cancel,
.btn-confirm {
  flex: 1;
  padding: 24rpx;
  border-radius: 12rpx;
  font-size: 32rpx;
  text-align: center;
}

.btn-cancel {
  background: #f5f5f5;
  color: #666;
}

.btn-confirm {
  background: linear-gradient(135deg, #4A90E2 0%, #357ABD 100%);
  color: #fff;
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(74, 144, 226, 0.3);
  transition: all 0.3s ease;
}

.btn-confirm:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 8rpx rgba(74, 144, 226, 0.2);
}

.btn-confirm[disabled] {
  background: #e0e0e0;
  color: #999;
  box-shadow: none;
}

/* 版本号样式 */
.version-info {
  position: absolute;
  bottom: 60rpx;
  left: 0;
  right: 0;
  text-align: center;
  z-index: 2;
  animation: fadeIn 1.2s ease 0.5s both;
}

.version-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
  letter-spacing: 1rpx;
  padding: 12rpx 24rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 20rpx;
  backdrop-filter: blur(10rpx);
  display: inline-block;
  transition: all 0.3s ease;
}

.version-text:active {
  background: rgba(255, 255, 255, 0.15);
  transform: scale(0.98);
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

