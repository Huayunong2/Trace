/* pages/index/index.wxss */

/* 顶部欢迎区域 */
.header-section {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 0 0 40rpx 40rpx;
  padding: 60rpx 32rpx 80rpx;
  margin-bottom: 24rpx;
  color: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.3);
}

.header-content {
  position: relative;
  z-index: 1;
}

.greeting-text {
  font-size: 48rpx;
  font-weight: bold;
  margin-bottom: 16rpx;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.2);
}

.subtitle-text {
  font-size: 28rpx;
  opacity: 0.9;
}

/* 预警提示卡片 */
.alert-card {
  background: linear-gradient(135deg, #FFF3E0 0%, #FFE0B2 100%);
  border-left: 6rpx solid #FF9800;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 4rpx 16rpx rgba(255, 152, 0, 0.2);
  animation: pulse 2s infinite;
}

.alert-icon {
  font-size: 64rpx;
  margin-right: 24rpx;
}

.alert-content {
  flex: 1;
}

.alert-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #E65100;
  margin-bottom: 8rpx;
}

.alert-desc {
  font-size: 24rpx;
  color: #FF9800;
}

@keyframes pulse {
  0%, 100% {
    transform: scale(1);
  }
  50% {
    transform: scale(1.02);
  }
}

/* 卡片头部 */
.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 32rpx;
  padding-bottom: 24rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.card-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
}

.card-count {
  font-size: 24rpx;
  color: #999;
  background: #f5f5f5;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
}

/* 老人列表项美化 */
.elderly-item {
  display: flex;
  align-items: center;
  padding: 32rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
  transition: all 0.3s ease;
}

.elderly-item:last-child {
  border-bottom: none;
}

.elderly-item:active {
  background-color: #f8f9fa;
  transform: translateX(4rpx);
}

.elderly-avatar-wrapper {
  position: relative;
  margin-right: 24rpx;
}

.elderly-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid #e9ecef;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.elderly-avatar.placeholder {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-icon {
  font-size: 64rpx;
}

.device-status {
  position: absolute;
  bottom: 0;
  right: 0;
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  border: 3rpx solid #fff;
}

.device-status.online {
  background: #27AE60;
}

.device-status.offline {
  background: #BDC3C7;
}

.elderly-info {
  flex: 1;
}

.elderly-name {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 12rpx;
}

.elderly-meta {
  font-size: 26rpx;
  color: #666;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  margin-bottom: 12rpx;
}

.meta-item {
  margin-right: 8rpx;
}

.meta-divider {
  margin: 0 8rpx;
  color: #ccc;
}

.meta-item.address {
  max-width: 300rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.device-info {
  margin-top: 8rpx;
}

.device-tag {
  font-size: 22rpx;
  padding: 6rpx 12rpx;
  border-radius: 12rpx;
  background: rgba(74, 144, 226, 0.1);
  color: #4A90E2;
}

.device-tag.warning {
  background: rgba(255, 152, 0, 0.1);
  color: #FF9800;
}

.arrow-icon {
  font-size: 48rpx;
  color: #ccc;
  font-weight: 300;
}

/* 添加按钮 */
.btn-add {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  box-shadow: 0 4rpx 16rpx rgba(102, 126, 234, 0.3);
  border: none;
}

.btn-add::after {
  border: none;
}

.add-icon {
  font-size: 40rpx;
  margin-right: 12rpx;
  font-weight: 300;
}

.add-icon-img {
  width: 32rpx;
  height: 32rpx;
  margin-right: 12rpx;
  vertical-align: middle;
}

.device-status-icon {
  position: absolute;
  bottom: 0;
  right: 0;
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  border: 2rpx solid #fff;
  background-color: #fff;
}

/* 快捷操作 */
.quick-actions {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.quick-action-item {
  width: 100%;
}

.quick-action-btn {
  width: 100%;
  height: 140rpx;
  background: linear-gradient(135deg, #4A90E2 0%, #357ABD 100%);
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-weight: 500;
  box-shadow: 0 4rpx 16rpx rgba(74, 144, 226, 0.3);
  border: none;
}

.quick-action-btn::after {
  border: none;
}

.quick-action-btn:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 12rpx rgba(74, 144, 226, 0.4);
}

.quick-action-disabled {
  width: 100%;
  height: 140rpx;
  background: #f5f5f5;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #999;
}

.action-icon {
  font-size: 48rpx;
  margin-bottom: 12rpx;
}

.action-text {
  font-size: 26rpx;
}
