<!--pages/index/index.wxml-->
<view class="container">
  <!-- 顶部欢迎区域 -->
  <view class="header-section">
    <view class="header-content">
      <view class="greeting-text">您好，{{userInfo && userInfo.username || '用户'}}</view>
      <view class="subtitle-text">
        <text wx:if="{{userInfo && userInfo.role === 'guardian'}}">守护家人的每一刻</text>
        <text wx:elif="{{userInfo && userInfo.role === 'elderly'}}">安全守护，让家人放心</text>
        <text wx:elif="{{userInfo && userInfo.role === 'community_admin'}}">社区管理服务平台</text>
        <text wx:elif="{{userInfo && userInfo.role === 'system_admin'}}">系统管理控制台</text>
        <text wx:else>防走失预警系统</text>
      </view>
    </view>
  </view>

  <!-- 预警提示 -->
  <view wx:if="{{unhandledAlertCount > 0}}" class="alert-card" bindtap="goToAlerts">
    <view class="alert-icon">⚠️</view>
    <view class="alert-content">
      <view class="alert-title">有 {{unhandledAlertCount}} 条未处理预警</view>
      <view class="alert-desc">点击查看详情 ></view>
    </view>
  </view>

  <!-- 老人列表 -->
  <view class="card">
    <view class="card-header">
      <view class="card-title">我的老人</view>
      <view class="card-count">{{elderlyList.length}} 位</view>
    </view>
    
    <view wx:if="{{loading}}" style="text-align: center; padding: 40rpx;">
      <text>加载中...</text>
    </view>
    
    <view wx:elif="{{elderlyList.length === 0}}" style="text-align: center; padding: 40rpx; color: #999;">
      <image src="/images/empty-elderly.png" mode="aspectFit" style="width: 200rpx; height: 200rpx; margin-bottom: 20rpx; opacity: 0.6;"></image>
      <view style="margin-top: 20rpx;">暂无老人信息，请添加</view>
    </view>
    
    <view wx:else>
      <view wx:for="{{elderlyList}}" wx:key="id" class="elderly-item" bindtap="goToElderlyDetail" data-id="{{item.id}}" bindlongpress="showElderlyActions" data-item="{{item}}">
        <view class="elderly-avatar-wrapper">
          <image wx:if="{{item.photo}}" src="{{item.photo}}" class="elderly-avatar"></image>
          <image wx:else src="{{item.gender === 'male' ? '/images/avatar-default-male.png' : item.gender === 'female' ? '/images/avatar-default-female.png' : '/images/avatar-default.png'}}" class="elderly-avatar" mode="aspectFill"></image>
          <image wx:if="{{item.device && item.device.device_id}}" src="{{item.device.status === 'online' ? '/images/status-online.png' : item.device.status === 'low_battery' ? '/images/status-battery-low.png' : '/images/status-offline.png'}}" class="device-status-icon"></image>
          <image wx:else src="/images/status-offline.png" class="device-status-icon"></image>
        </view>
        <view class="elderly-info">
          <view class="elderly-name">{{item.name}}</view>
          <view class="elderly-meta">
            <text class="meta-item">{{item.age}}岁</text>
            <text class="meta-divider">•</text>
            <text class="meta-item">{{item.gender === 'male' ? '男' : '女'}}</text>
            <text wx:if="{{item.address}}" class="meta-divider">•</text>
            <text wx:if="{{item.address}}" class="meta-item address">{{item.address}}</text>
          </view>
          <view wx:if="{{item.device && item.device.device_id}}" class="device-info">
            <text class="device-tag">📍 已绑定设备</text>
          </view>
          <view wx:else class="device-info">
            <text class="device-tag warning">⚠️ 未绑定设备</text>
          </view>
        </view>
        <view class="arrow-icon">›</view>
      </view>
    </view>
    
    <view style="margin-top: 30rpx;">
      <button class="btn-add" bindtap="addElderly">
        <image src="/images/add.png" class="add-icon-img" mode="aspectFit"></image>
        <text>添加老人</text>
      </button>
    </view>
  </view>

  <!-- 快捷操作 -->
  <view class="card">
    <view class="card-header">
      <view class="card-title">快捷操作</view>
    </view>
    <view class="quick-actions">
      <view wx:for="{{elderlyList}}" wx:key="id" wx:for-item="elderly" class="quick-action-item">
        <button wx:if="{{elderly.device && elderly.device.device_id}}" class="quick-action-btn" bindtap="goToMap" data-device-id="{{elderly.device.device_id}}">
          <text class="action-icon">📍</text>
          <text class="action-text">查看{{elderly.name}}位置</text>
        </button>
        <view wx:else class="quick-action-disabled">
          <text class="action-icon">⚠️</text>
          <text class="action-text">{{elderly.name}}暂无设备</text>
        </view>
      </view>
    </view>
  </view>
</view>

