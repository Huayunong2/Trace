/* pages/map/map.wxss */

/* 无位置数据卡片 */
.no-location-card {
  position: fixed;
  bottom: 200rpx;
  left: 20rpx;
  right: 20rpx;
  z-index: 100;
  background: linear-gradient(135deg, #FFF3E0 0%, #FFE0B2 100%);
  border-left: 8rpx solid #FF9800;
  border-radius: 20rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(255, 152, 0, 0.2);
  text-align: center;
}

.no-location-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.no-location-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #E65100;
  margin-bottom: 12rpx;
}

.no-location-desc {
  font-size: 26rpx;
  color: #FF9800;
  line-height: 1.5;
  margin-bottom: 12rpx;
}

.no-location-tip {
  font-size: 22rpx;
  color: #FFB74D;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(255, 152, 0, 0.2);
}

/* 无设备提示卡片 */
.no-device-card {
  position: fixed;
  bottom: 200rpx;
  left: 20rpx;
  right: 20rpx;
  z-index: 100;
  background: linear-gradient(135deg, #E3F2FD 0%, #BBDEFB 100%);
  border-left: 8rpx solid #2196F3;
  border-radius: 20rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(33, 150, 243, 0.2);
  text-align: center;
}

.no-device-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.no-device-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #1976D2;
  margin-bottom: 12rpx;
}

.no-device-desc {
  font-size: 26rpx;
  color: #2196F3;
  line-height: 1.5;
}

/* 位置信息卡片 */
.location-info-card {
  background: linear-gradient(135deg, #ffffff 0%, #f8f9fa 100%);
  border-radius: 24rpx;
  padding: 28rpx;
  margin: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.1);
  position: relative;
  overflow: hidden;
}

.location-info-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 6rpx;
  background: linear-gradient(90deg, #4A90E2 0%, #357ABD 100%);
}

.location-header {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.location-name {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
  line-height: 1.4;
}

.location-time {
  color: #999;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

/* 操作按钮组 */
.action-buttons {
  display: flex;
  gap: 20rpx;
  margin-top: 24rpx;
}

.action-btn {
  flex: 1;
  border-radius: 12rpx;
  padding: 28rpx;
  font-weight: 500;
  font-size: 32rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
  transition: all 0.3s ease;
}

.action-btn:active {
  transform: translateY(2rpx);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.15);
}

/* 底部操作栏 */
.bottom-actions {
  padding: 24rpx;
  background: #fff;
  border-top: 1rpx solid #f0f0f0;
}
