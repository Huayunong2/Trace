/* pages/profile/profile.wxss */

/* 用户信息卡片 */
.user-info-card {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 0 0 40rpx 40rpx;
  padding: 60rpx 32rpx 80rpx;
  margin: -24rpx -24rpx 32rpx;
  color: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.3);
  position: relative;
  overflow: hidden;
}

.user-info-card::before {
  content: '';
  position: absolute;
  width: 400rpx;
  height: 400rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 50%;
  top: -150rpx;
  right: -150rpx;
}

.user-avatar-wrapper {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  margin: 0 auto 32rpx;
}

.user-avatar {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.2);
}

.user-info {
  text-align: center;
  position: relative;
  z-index: 1;
}

.user-name {
  font-size: 48rpx;
  font-weight: bold;
  margin-bottom: 16rpx;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.2);
}

.user-phone {
  font-size: 28rpx;
  opacity: 0.9;
  margin-bottom: 12rpx;
}

.user-id {
  font-size: 24rpx;
  opacity: 0.7;
}

.user-role {
  margin-top: 12rpx;
  margin-bottom: 8rpx;
}

.role-badge {
  display: inline-block;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  font-weight: 500;
  background-color: rgba(255, 255, 255, 0.3);
  color: #fff;
}

.role-badge.role-guardian {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  box-shadow: 0 4rpx 12rpx rgba(102, 126, 234, 0.3);
}

.role-badge.role-elderly {
  background: linear-gradient(135deg, #ff9a56 0%, #ff6a88 100%);
  box-shadow: 0 4rpx 12rpx rgba(255, 154, 86, 0.3);
}

.role-badge.role-community_admin {
  background-color: rgba(255, 152, 0, 0.8);
}

.role-badge.role-system_admin {
  background-color: rgba(231, 76, 60, 0.8);
}

/* 菜单卡片 */
.menu-card {
  margin-bottom: 24rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 32rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
  transition: all 0.3s ease;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item:active {
  background-color: #f8f9fa;
  transform: translateX(4rpx);
}

.menu-icon {
  font-size: 40rpx;
  margin-right: 24rpx;
  width: 48rpx;
  text-align: center;
}

.menu-icon-img {
  width: 36rpx;
  height: 36rpx;
  margin-right: 24rpx;
  vertical-align: middle;
}

.menu-text {
  flex: 1;
  font-size: 32rpx;
  color: #333;
}

.menu-arrow {
  font-size: 40rpx;
  color: #ccc;
  font-weight: 300;
}

/* 退出登录按钮 */
.logout-btn {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #E74C3C 0%, #C0392B 100%);
  border-radius: 16rpx;
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
  box-shadow: 0 4rpx 16rpx rgba(231, 76, 60, 0.3);
}

.logout-btn::after {
  border: none;
}

.logout-btn:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 12rpx rgba(231, 76, 60, 0.4);
}
